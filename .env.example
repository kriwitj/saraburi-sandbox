# ==========================================
# Saraburi-Sandbox Platform Environment Config
# ==========================================
# Note: If no .env file exists, docker-compose.yml will use the default values shown below.

# Domain Configuration (for Traefik reverse proxy)
APP_DOMAIN=saraburi-sandbox.saraburidev.org

# PostgreSQL Database Configuration
POSTGRES_DB=saraburi_sandbox
POSTGRES_USER=postgres
POSTGRES_PASSWORD=saraburi_sandbox_secret
POSTGRES_PORT=5432

# Backend Service Configuration
PORT=5000
NODE_ENV=production
